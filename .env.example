# ── OpenAlex API ──────────────────────────────────────────────────────────
# Recommended: provide email for polite OpenAlex API pool
OPENALEX_EMAIL=your.email@example.com

# ── NIH RePORTER API ─────────────────────────────────────────────────────
# Optional: NIH API key for higher rate limits (https://api.reporter.nih.gov/)
NIH_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────
# Optional: for automated FOIA document fetching
GITHUB_TOKEN=

# ── ZonMw ──────────────────────────────────────────────────────────────────
# Optional: ZonMw API endpoint if available
ZONMW_API_KEY=
